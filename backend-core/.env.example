APP_NAME="Plataforma Electoral Colombia"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=America/Bogota
APP_URL=http://localhost:8000

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_CO

APP_MAINTENANCE_DRIVER=file
APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Database - PostgreSQL con PostGIS
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=electoral_platform
DB_USERNAME=postgres
DB_PASSWORD=postgres_secret_2024

# PostGIS habilitado automáticamente en migrations
POSTGIS_VERSION=3.4

# Session & Cache - Redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=redis
# No hay config/filesystems.php en este proyecto (Laravel 11 sin publicar),
# y ningún código lee FILESYSTEM_DISK ni usa Storage::disk('s3') -
# ProcesarImagenActaJob siempre usa Storage::disk('public') hardcodeado
# para las fotos de actas. 's3' aquí era engañoso: sugiere una durabilidad
# (S3) que el sistema nunca tuvo; las evidencias siempre viven en disco
# local del servidor/contenedor (ver nota de despliegue en el Dockerfile
# sobre volúmenes persistentes).
FILESYSTEM_DISK=public
QUEUE_CONNECTION=redis

CACHE_STORE=redis
CACHE_PREFIX=electoral
CACHE_TTL=3600

REDIS_CLIENT=predis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=0

# Sanctum (Laravel API Authentication)
SANCTUM_STATEFUL_DOMAINS=localhost,127.0.0.1,localhost:3000
SANCTUM_TOKEN_EXPIRATION=null

MAIL_MAILER=smtp
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="noreply@plataforma-electoral.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

AWS_SES_KEY=
AWS_SES_SECRET=
AWS_SES_REGION=us-east-1

TWILIO_SID=
TWILIO_TOKEN=
TWILIO_FROM=

# Debe ser IDÉNTICO al JWT_SECRET de backend-diad/.env. Generar con:
#   php -r "echo bin2hex(random_bytes(32));"
JWT_SECRET=

WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_BUSINESS_ID=
# App Secret de Meta (no el token de acceso): firma los eventos del webhook
# vía X-Hub-Signature-256. Sin esto, cualquiera puede forjar eventos de
# WhatsApp (mensajes/estados falsos).
WHATSAPP_APP_SECRET=

WOMPI_PUBLIC_KEY=
WOMPI_PRIVATE_KEY=
WOMPI_EVENTS_SECRET=

VITE_APP_NAME="${APP_NAME}"
