# Application
NODE_ENV=development
PORT=3000
APP_NAME=Backend Día D

# Database
DB_TYPE=postgres
DB_HOST=postgres
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=secret
DB_DATABASE=electoral_platform
DB_SCHEMA=diad
DB_SYNCHRONIZE=false
DB_LOGGING=true

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# AWS
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET_ACTAS=electoral-actas

# AWS Textract (OCR)
AWS_TEXTRACT_REGION=us-east-1

# JWT
JWT_SECRET=your-secret-key-change-this
JWT_EXPIRES_IN=7d

# WebSocket
WEBSOCKET_CORS_ORIGIN=http://localhost:5173,http://localhost:5174

# Laravel Backend Core URL (for internal communication)
BACKEND_CORE_URL=http://backend-core:8000/api/v1
BACKEND_CORE_API_KEY=

# Rate Limiting
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100
